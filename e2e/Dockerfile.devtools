# syntax=docker/dockerfile:1
# Debian image with Node 20/22, Temurin JDK 17/21 and common CLI tools
# (bat, fd, ripgrep, jq, delta, gh), all installed by paq from
# e2e/devtools.toml. Build from the repository root:
#
#   docker build -t paq-devtools -f e2e/Dockerfile.devtools .
#
# Pass a GitHub token to avoid API rate limits:
#
#   docker build --secret id=GITHUB_TOKEN,env=GITHUB_TOKEN -t paq-devtools -f e2e/Dockerfile.devtools .
#
# Node 22 and JDK 21 are on PATH by default; switch with e.g.
#
#   docker run --rm -it -e PATH=/opt/node-20/bin:/opt/jdk-17/bin:/usr/local/bin:/usr/bin:/bin -e JAVA_HOME=/opt/jdk-17 paq-devtools

FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-s" -o /paq ./cmd/paq

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git less xz-utils \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /paq /usr/local/bin/paq
COPY e2e/devtools.toml /etc/paq/config.toml
ENV PAQ_CONFIG=/etc/paq/config.toml
RUN --mount=type=secret,id=GITHUB_TOKEN,env=GITHUB_TOKEN paq install
ENV JAVA_HOME=/opt/jdk-21
ENV PATH="/opt/node-22/bin:/opt/jdk-21/bin:${PATH}"
WORKDIR /root
CMD ["/bin/bash"]
