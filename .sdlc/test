#!/usr/bin/env bash

set -euo pipefail

tool_source="${BASH_SOURCE[0]}"
while [ -h "$tool_source" ]; do tool_source="$(readlink "$tool_source")"; done
sdlc_dir="$( cd -P "$( dirname "$tool_source" )" && pwd )"
prj_home="$( cd -P "$( dirname "$sdlc_dir" )" && pwd )"

cd "${prj_home}"

# -shuffle=on catches tests that depend on the execution order of their
# siblings (typically a global left dirty); -race catches data races in the
# parallel install/upgrade paths. The suite runs in well under a second, so
# both are free.
echo "==> test"
go test ./... -shuffle=on -race "$@"
echo "    ok"
